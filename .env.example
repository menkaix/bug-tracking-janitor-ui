# URL de l'API Backend
REACT_APP_API_URL=http://localhost:3000

# Configuration du logging
# Niveau de log: ERROR, WARN, INFO, DEBUG
# Par défaut: DEBUG en dev, INFO en prod
REACT_APP_LOG_LEVEL=DEBUG

# Endpoint optionnel pour envoyer les logs critiques au serveur
# REACT_APP_LOG_ENDPOINT=http://localhost:3000/api/logs

# Firebase (récupérer ces valeurs dans la Firebase Console > Paramètres du projet)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=votre-projet
